# Copy to bootstrap/config.env and edit before running anything.
# config.env is gitignored.

# Target disk. THIS DISK WILL BE WIPED.
# Check with: lsblk -d -o NAME,SIZE,MODEL,TRAN
DISK="/dev/nvme0n1"

HOSTNAME="t480"
USERNAME="eddo"

TIMEZONE="Europe/London"
LOCALE="en_GB.UTF-8"
KEYMAP="uk"          # console keymap; see: localectl list-keymaps
XKB_LAYOUT="gb"      # niri keyboard layout

ESP_SIZE="1G"

# 0 = zram only (recommended).
# Set e.g. "16G" (>= RAM) for a disk swap partition; hibernate needs
# additional resume configuration (see the Arch wiki).
SWAP_SIZE="0"

# Space-separated. Each kernel gets a systemd-boot entry.
KERNELS="linux linux-lts"
