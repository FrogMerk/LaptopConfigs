#!/usr/bin/env bash
# Region screenshot -> satty annotation -> clipboard + file.
set -Eeuo pipefail

dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"

if ! command -v satty >/dev/null 2>&1; then
  echo "satty is not installed." >&2
  exit 1
fi

if ! geometry="$(slurp)"; then
  exit 0
fi

tmp="$(mktemp --suffix=.png)"
trap 'rm -f "$tmp"' EXIT

grim -g "$geometry" "$tmp"

out="$dir/Screenshot from $(date +'%Y-%m-%d %H-%M-%S').png"
satty --filename "$tmp" --output-filename "$out" --copy-command wl-copy
