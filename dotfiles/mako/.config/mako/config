font=JetBrainsMono Nerd Font 11
background-color=#2d353be6
text-color=#d3c6aa
border-color=#a7c080
progress-color=over #425047
border-size=2
border-radius=10
default-timeout=5000
max-visible=5
width=380
height=140
margin=14
padding=14
anchor=top-right
icons=0
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
max-icon-size=48
icon-border-radius=8
group-by=app-name
max-history=50
history=1
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss

[urgency=critical]
border-color=#e67e80
background-color=#514045e6
default-timeout=0

[urgency=low]
border-color=#7a8478
default-timeout=3000
