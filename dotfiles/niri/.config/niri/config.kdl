// ~/.config/niri/config.kdl
// Minimal T480 config. niri loads NO default binds, so keep what you want.
// Validate after edits with: niri validate

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
    }

    mouse {
        accel-speed 0.0
    }

    // Disabled by default on a laptop: the cursor moving over a window
    // should not steal focus while you are typing.
    // focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    scale 1.0
}

// External display template: uncomment and adjust when docked.
// output "HDMI-A-1" {
//     scale 1.0
//     position x=1920 y=0
// }

// Named workspaces. Number keys 1-6 map to these; 7-9 stay dynamic.
workspace "term"
workspace "web"
workspace "code"
workspace "media"
workspace "chat"
workspace "files"

overview {
    zoom 0.5
    backdrop-color "#232a2e"

    workspace-shadow {
        softness 40
        spread 10
        offset x=0 y=10
        color "#00000060"
    }
}

// Blur is rendered once against the wallpaper (xray) and reused, so it is
// effectively free while idle. Values are tuned for a soft, low-contrast look.
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.2
}

layout {
    gaps 12
    center-focused-column "never"
    background-color "#2d353b"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#a7c080"
        inactive-color "#475258"
    }

    border {
        off
    }

    shadow {
        off
    }
}

// --- Window rules -----------------------------------------------------------

// Small utilities and dialogs float.
window-rule {
    match app-id="^(pavucontrol|nm-connection-editor|blueman-manager|org.gnome.Calculator|org.gnome.Settings|org.gnome.DiskUtility|gparted|file-roller|xdg-desktop-portal-gtk|swappy)$"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.7; }
}

// Viewers open floating at a comfortable size.
window-rule {
    match app-id="^(imv|mpv|org.gnome.Loupe|eog)$"
    open-floating true
    open-on-workspace "media"
    default-column-width { fixed 1280; }
    default-window-height { fixed 720; }
}

// Firefox Picture-in-Picture: small, bottom-right, never steal focus.
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture"
    open-floating true
    open-focused false
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

// Firefox gets a wider column; the PiP window is excluded above.
window-rule {
    match app-id="firefox$"
    exclude title="^Picture-in-Picture"
    open-on-workspace "web"
    default-column-width { proportion 0.66; }
}

// File manager: half-screen column on its own workspace.
window-rule {
    match app-id="org.gnome.Nautilus"
    open-on-workspace "files"
    default-column-width { proportion 0.5; }
}

// Chat and code apps land on their dedicated workspaces when they arrive.
window-rule {
    match app-id=r#"(?i)^(discord|signal|org\.telegram\.desktop|element|slack)$"#
    open-on-workspace "chat"
}

window-rule {
    match app-id=r#"(?i)^(code|codium|neovide|jetbrains-.*)$"#
    open-on-workspace "code"
}

// Dropdown terminal, bound to Mod+Grave.
window-rule {
    match app-id="^dropdown$"
    open-floating true
    default-floating-position x=0 y=0 relative-to="top"
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.5; }
}

// Rounded corners for tiled windows.
window-rule {
    match is-floating=false
    geometry-corner-radius 12
    clip-to-geometry true
}

// Rounded corners for floating windows.
window-rule {
    match is-floating=true
    geometry-corner-radius 12
    clip-to-geometry true
}

// Soft shadow for floating windows.
window-rule {
    match is-floating=true
    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=8
        color "#00000060"
    }
}

// Frosted terminal and dropdown, using Alacritty's 0.85 opacity.
window-rule {
    match app-id="^(Alacritty|dropdown)$"
    background-effect {
        blur true
    }
}

// Frosted launcher and notification surfaces.
layer-rule {
    match namespace="^(launcher|notifications)$"
    background-effect {
        blur true
    }
}

// Keep password managers out of screencasts.
window-rule {
    match app-id="^(org.keepassxc.KeePassXC|Bitwarden|1password)$"
    block-out-from "screencast"
}

// Subtle, critically damped motion. Idle power is unaffected; the iGPU only
// wakes for the short transitions themselves.
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1100 epsilon=0.0001
    }

    window-open {
        duration-ms 140
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 120
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=950 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=950 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=950 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.9 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.9 stiffness=600 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 180
        curve "ease-out-cubic"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=950 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=950 epsilon=0.001
    }
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 1000
}

environment {
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

spawn-at-startup "mako"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "waybar"
spawn-at-startup "playerctld" "daemon"
spawn-at-startup "udiskie" "--automount" "--notify" "--tray"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "swayidle" "-w" "timeout" "300" "$HOME/.local/bin/lock-screen" "timeout" "360" "niri msg action power-off-monitors" "timeout" "1200" "systemctl suspend" "before-sleep" "$HOME/.local/bin/lock-screen"

hotkey-overlay {
    skip-at-startup
}

binds {
    // Applications
    Mod+T { spawn "alacritty"; }
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+E { spawn "nautilus"; }
    Mod+Grave { spawn "alacritty" "--class" "dropdown"; }
    Mod+Shift+D { spawn-sh "$HOME/.local/bin/dock extend"; }
    Mod+Q repeat=false { close-window; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // Move columns and windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    // Workspaces
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }

    Mod+1 { focus-workspace "term"; }
    Mod+2 { focus-workspace "web"; }
    Mod+3 { focus-workspace "code"; }
    Mod+4 { focus-workspace "media"; }
    Mod+5 { focus-workspace "chat"; }
    Mod+6 { focus-workspace "files"; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace "term"; }
    Mod+Shift+2 { move-column-to-workspace "web"; }
    Mod+Shift+3 { move-column-to-workspace "code"; }
    Mod+Shift+4 { move-column-to-workspace "media"; }
    Mod+Shift+5 { move-column-to-workspace "chat"; }
    Mod+Shift+6 { move-column-to-workspace "files"; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Layout
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+Space { switch-focus-between-floating-and-tiling; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+O { toggle-overview; }
    Mod+Shift+V { spawn-sh "$HOME/.local/bin/clipboard-history"; }
    Mod+Shift+W { spawn-sh "$HOME/.local/bin/wallpaper pick"; }
    Mod+Alt+W { spawn-sh "$HOME/.local/bin/wallpaper next"; }

    // Session, screenshots, hotkey help
    Super+Alt+L { spawn-sh "$HOME/.local/bin/lock-screen"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Print { screenshot; }
    Mod+Shift+Print { screenshot-screen; }
    // T480's Print key can be awkward to reach; keep an alternative.
    Mod+S { screenshot; }
    Mod+Shift+S { screenshot-screen; }
    // Region / full-screen straight to the clipboard (no file).
    Mod+Alt+Print { spawn-sh "$HOME/.local/bin/screenshot-region"; }
    Mod+Alt+S { spawn-sh "$HOME/.local/bin/screenshot-region"; }
    Mod+Alt+Shift+Print { spawn-sh "$HOME/.local/bin/screenshot-full"; }
    Mod+Shift+P { power-off-monitors; }

    // Laptop keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}
